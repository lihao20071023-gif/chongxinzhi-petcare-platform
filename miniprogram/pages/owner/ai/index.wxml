<view class="page">
  <view class="hero"><view class="eyebrow">AI CARE ASSISTANT</view><view class="title">问护理，不替代诊断</view><view class="subtitle">回答说明使用了哪些宠物资料、引用哪条已审核知识；资料不足时先追问，危急症状优先提示就医。</view></view>
  <view wx:if="{{error}}" class="notice error">{{error}}</view>
  <view class="chat"><view wx:for="{{messages}}" wx:key="index" class="bubble {{item.role}}"><view>{{item.text}}</view><view wx:if="{{item.sources && item.sources.length}}" class="sources">依据：<text wx:for="{{item.sources}}" wx:key="id">【{{item.label}}】</text></view></view></view>
  <view class="card composer"><textarea class="textarea" value="{{question}}" bindinput="input" placeholder="例如：今天比平时少吃一半，我应该记录什么？"/><button class="primary" loading="{{sending}}" disabled="{{sending}}" bindtap="send">发送问题</button></view>
  <view class="bottom-note">用药剂量、停药、加药和诊断决定必须由执业兽医确认。</view>
</view>
<role-tabs role="pet_owner" active="ai"/>
