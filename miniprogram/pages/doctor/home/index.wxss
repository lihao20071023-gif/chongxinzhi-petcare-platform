.doctor { background: linear-gradient(145deg,#e5eef8,#fbfdff 58%,#e7f3ed); }.stats { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(3,1fr); gap: 10rpx; margin-top: 28rpx; }.stats view { padding: 18rpx 8rpx; border-radius: 18rpx; background: rgba(255,255,255,.76); text-align: center; }.stats text { display:block; font-size: 21rpx; color:#6b7a84; }.stats text:first-child { font-size: 34rpx; font-weight:800; color:#356d94; }.blue { background:#e3edf7; }
