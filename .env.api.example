API_HOST=127.0.0.1
API_PORT=8787
NODE_ENV=development
# Comma-separated browser origins allowed to use the API. WeChat wx.request does not rely on browser CORS.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3300,http://localhost:3300

# PostgreSQL is provided by one Supabase project.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_PROJECT_JWT_SECRET

# WeChat Mini Program
WECHAT_APP_ID=YOUR_WECHAT_APP_ID
WECHAT_APP_SECRET=YOUR_WECHAT_APP_SECRET
WECHAT_OPENID_PEPPER=GENERATE_A_LONG_RANDOM_SECRET

# OpenAI-compatible model gateway (server side only)
AI_PROVIDER_MODE=cloud
AI_API_URL=https://YOUR_AI_PROVIDER/v1/chat/completions
AI_API_KEY=YOUR_AI_KEY
AI_MODEL=YOUR_MODEL_NAME
AI_TIMEOUT_MS=45000
WECHAT_TIMEOUT_MS=10000

# Independent React admin Web console (set in admin-web/.env.local at runtime)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8787/api/v1

# Private Supabase Storage bucket for medical reports
REPORTS_BUCKET=medical-reports

# First administrator only. Generate a random value of at least 24 characters,
# use it once on the Web setup page, then remove it and restart the API.
ADMIN_SETUP_TOKEN=GENERATE_A_ONE_TIME_RANDOM_SECRET
